# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Services
CORE_SERVICE_BASE_URL=http://localhost:4000
SEARCH_SERVICE_BASE_URL=http://localhost:4001
CHAT_SERVICE_BASE_URL=http://localhost:4002
PUBLIC_API_GATEWAY_BASE_URL=http://localhost:4000
CORE_SERVICE_INTERNAL_TOKEN=
SEARCH_SERVICE_INTERNAL_TOKEN=
CHAT_SERVICE_INTERNAL_TOKEN=
TEST_ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/
MONGODB_DB=ecommerce_demo
MONGODB_VECTOR_INDEX_NAME=product_embeddings_ollama_768
MONGODB_SEARCH_INDEX_NAME=products_keyword

# Auth
AUTH_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ENVIRONMENTS=demo,staging
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=
PASSWORD_HASH_ALGORITHM=argon2id
COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_SECONDS=604800
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=

# Dataset and images
DATASET_NAME=kaggle-fashion-product-images
DATASET_PATH=./dataset
PRODUCT_IMAGE_STORAGE=local_filesystem
PRODUCT_IMAGE_LOCAL_ROOT=./dataset/images
PRODUCT_IMAGE_PUBLIC_BASE_URL=/product-images
INGESTION_OUTPUT_DIR=./artifacts/ingestion
CORE_SERVICE_DATA_PATH=./artifacts/core_service/state.json
CHAT_SERVICE_DATA_PATH=./artifacts/chat_service/state.json
PRODUCTS_JSONL_PATH=./artifacts/ingestion/products.jsonl
PRODUCT_EMBEDDINGS_JSONL_PATH=./artifacts/embeddings/product_embeddings.jsonl

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
LLM_API_KEY=replace-with-llm-api-key
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.3
LLM_STREAMING_ENABLED=true

# Embeddings
EMBEDDING_PROVIDER=mongodb_atlas_autoembed
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TEXT_TEMPLATE_VERSION=product-v1
EMBEDDING_TEXT_MAX_CHARS=4000
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_MS=60000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_PATH=/api/embed
# Atlas Automated Embedding uses Atlas-managed Voyage models and does not call this endpoint.
VOYAGE_API_BASE_URL=https://ai.mongodb.com/v1/embeddings
VOYAGE_API_KEY=
VOYAGE_INPUT_TYPE_DOCUMENT=document
VOYAGE_INPUT_TYPE_QUERY=query

# Voice support — standalone ElevenLabs STT/TTS APIs
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_VOICE_ID=replace-with-elevenlabs-voice-id
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_API_URL=https://api.elevenlabs.io/v1/speech-to-text
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_API_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_16000

# Local mock telephony (v1 only)
VOICE_TELEPHONY_PROVIDER=local
VOICE_STREAM_WS_AUTH_TOKEN=replace-with-local-voice-stream-token
VOICE_MOCK_TELEPHONY_TARGET_WS_URL=ws://localhost:4002/api/voice/stream
VOICE_MOCK_TELEPHONY_SAMPLE_RATE=16000
VOICE_MOCK_TELEPHONY_AUDIO_FORMAT=pcm16
VOICE_MOCK_TELEPHONY_INPUT_DEVICE=default
VOICE_MOCK_TELEPHONY_OUTPUT_DEVICE=default
VOICE_AGENT_SESSION_TYPE=voice_support
VOICE_CALLER_VERIFICATION_MAX_ATTEMPTS=2
VOICE_VAD_SILENCE_THRESHOLD_DB=-40
VOICE_VAD_SILENCE_DURATION_MS=600
VOICE_VAD_MIN_UTTERANCE_MS=250
VOICE_TURN_MAX_LATENCY_MS=3000

# Private voice call recordings
AWS_REGION=
AWS_S3_CALL_RECORDINGS_BUCKET=
CALL_RECORDING_RETENTION_DAYS=1

# Codex MCP
CODEX_MCP_ENABLED=true
CODEX_MCP_TRANSPORT=stdio
CODEX_MCP_COMMAND=codex
CODEX_MCP_ARGS=mcp,serve
CODEX_MCP_URL=http://localhost:9000/mcp
CODEX_MCP_TIMEOUT_MS=120000

# Demo checkout
CHECKOUT_PAYMENT_PROVIDER=demo
DEMO_CURRENCY=INR
DEMO_TAX_PERCENT=18
DEMO_FREE_SHIPPING_THRESHOLD=3000
DEMO_SHIPPING_FEE=99

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# Chat Service logging
CHAT_LOG_LEVEL=DEBUG
CHAT_LOG_REQUEST_BODIES=true
CHAT_LOG_RESPONSE_BODIES=true
